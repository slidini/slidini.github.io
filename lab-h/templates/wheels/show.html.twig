{% extends 'base.html.twig' %}

{% block title %}Wheels{% endblock %}

{% block body %}

    <table class="table table-dark table-striped table-hover">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ wheel.id }}</td>
            </tr>
            <tr>
                <th>Brand</th>
                <td>{{ wheel.brand }}</td>
            </tr>
            <tr>
                <th>Size</th>
                <td>{{ wheel.size }}</td>
            </tr>
            <tr>
                <th>Color</th>
                <td>{{ wheel.color }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_wheels_index') }}" class="btn btn-secondary">back to list</a>

    <a href="{{ path('app_wheels_edit', {'id': wheel.id}) }}" class="btn btn-secondary">edit</a>

    {{ include('wheels/_delete_form.html.twig') }}
{% endblock %}
