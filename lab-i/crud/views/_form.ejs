<div class="form-group">
    <label for="brand">Brand</label>
    <input type="text" id="brand" name="brand" value="<%= typeof wheel !== 'undefined' ? wheel.brand : '' %>">
</div>

<div class="form-group">
    <label for="size">Size</label>
    <input type="number" id="size" name="size" value="<%= typeof wheel !== 'undefined' ? wheel.size : '' %>">
</div>

<div class="form-group">
    <label for="color">Color</label>
    <input type="text" id="color" name="color" value="<%= typeof wheel !== 'undefined' ? wheel.color : '' %>">
</div>

<div class="form-group">
    <label></label>
    <input type="submit" value="Submit">
</div>