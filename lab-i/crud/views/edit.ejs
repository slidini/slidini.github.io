<%- include('header') %>
<h1>Edit Wheels</h1>
<form action="/wheels/<%= wheel.id %>/edit" method="post" class="form">
    <div class="form-group"><label>Brand</label><input type="text" name="brand" value="<%= wheel.brand %>"></div>
    <div class="form-group"><label>Size</label><input type="number" name="size" value="<%= wheel.size %>"></div>
    <div class="form-group"><label>Color</label><input type="text" name="color" value="<%= wheel.color %>"></div>
    <div class="form-group">
        <label></label>
        <input type="submit" value="Submit">
    </div>
</form>

<form action="/wheels/<%= wheel.id %>/delete" method="post" class="form">
    <div class="form-group">
        <label></label>
        <input type="submit" value="Delete" onclick="return confirm('Are you sure?')">
    </div>
</form>

<ul class="action-list">
    <li><a href="/wheels">Back to list</a></li>
</ul>
<%- include('footer') %>
